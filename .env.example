# =================================================================
# Nexa / The Global Dispatch - Environment Variables Configuration
# =================================================================

# Google Gemini AI API Key (Optional)
# Enables generative AI executive intelligence summaries, takeaways, and sentiment analysis.
# If omitted, the platform uses its built-in Content-Aware Semantic NLP Extraction engine.
GEMINI_API_KEY=your_gemini_api_key_here

# GNews API Key (Optional)
# If provided, enables GNews live wire headlines and search queries.
# Free tier key can be obtained at: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# NewsAPI API Key (Optional)
# If provided, acts as secondary news provider before falling back to Google News Live RSS.
# Key can be obtained at: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here
